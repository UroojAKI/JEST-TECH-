# ==============================================================================
# JEST POLICY CRM API - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
NODE_ENV=development
PORT=4000
APP_NAME=JEST Policy CRM API

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jest_policy_crm?schema=public

JWT_SECRET=generate_at_least_32_characters_random_jwt_secret_value_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_different_32_characters_random_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

PII_ENCRYPTION_KEY=generate_at_least_32_characters_random_pii_encryption_key_here
RAZORPAY_WEBHOOK_SECRET=generate_random_webhook_secret_key_from_razorpay_dashboard
METRICS_SCRAPE_TOKEN=generate_at_least_16_characters_prometheus_metrics_token_here

ENABLE_SWAGGER=true
