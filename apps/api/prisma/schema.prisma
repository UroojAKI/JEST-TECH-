generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  TEAM_LEADER
  SALES_AGENT
  OPERATIONS
  UNDERWRITER
  CLAIMS_OFFICER
  FINANCE
  SUPPORT
  CUSTOMER
  MD_CEO
  CHIEF_FINANCE_OFFICER
  SALES_MANAGER
  SALES_EXECUTIVE
  POLICY_ISSUANCE_EXECUTIVE
  RENEWAL_EXECUTIVE
  CUSTOMER_SERVICE_EXECUTIVE
  FINANCE_ACCOUNTS_EXECUTIVE
  SYSTEM_ADMINISTRATOR
  POSP_ADVISOR
  AGENT_MANAGER
  MARKETING_DIRECTOR
}

enum PermissionCategory {
  SYSTEM
  USER
  ROLE
  CONTACT
  ACCOUNT
  LEAD
  QUOTATION
  POLICY
  CLAIM
  REPORT
  WORKFLOW
  DOCUMENT
  DASHBOARD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  APPROVE
  REJECT
  SAOD_TP_VERIFICATION_RECORDED
}

enum ContactType {
  INDIVIDUAL
  CORPORATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountType {
  INDIVIDUAL
  CORPORATE
  SME
  ENTERPRISE
  GOVERNMENT
}

enum CommunicationChannel {
  EMAIL
  PHONE
  SMS
  WHATSAPP
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LeadSource {
  WALK_IN
  REFERRAL
  ADVISOR
  DIGITAL
  RENEWAL
  CROSS_SELL
  CAMPAIGN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  DOCS_RECEIVED
  QUOTE_PREPARED
  NEGOTIATION
  PAYMENT_RECEIVED
  POLICY_ISSUED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_POLICY
}

enum IssuanceStatus {
  DRAFT
  PROPOSAL_READY
  SUBMITTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  ISSUANCE_PENDING
  ISSUED
  VERIFICATION_PENDING
  VERIFIED
}

enum CrmCompletionStatus {
  INCOMPLETE
  READY
  COMPLETED
}

enum PolicyStatus {
  DRAFT
  ISSUED
  ACTIVE
  LAPSED
  RENEWED
  CANCELLED
  PENDING_RENEWAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum VehicleStatus {
  NEW
  EXISTING
}

enum AddonRateType {
  PERCENT_OF_IDV
  PERCENT_OF_OD
  FIXED
  TIERED
  FORMULA
  INSURER_QUOTE
  MANUAL
}

enum RateSourceType {
  IRDAI_RULE
  IRDAI_NOTIFICATION
  INSURER_FILED_RATE
  INSURER_PRODUCT
  ADMIN_CONFIG
}

//////////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////////

model Role {
  id   String   @id @default(uuid())
  name String   @unique
  code String   @unique
  type RoleType @unique

  description String?

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  users               User[]
  permissions         RolePermission[]
  workflowAssignments WorkflowAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@map("roles")
}

//////////////////////////////////////////////////////////
// PERMISSIONS
//////////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid())

  name String @unique

  code String @unique

  description String?

  category PermissionCategory

  roles RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("permissions")
}

//////////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////////

model RolePermission {
  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

//////////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  employeeCode String? @unique

  firstName String

  lastName String

  email String @unique

  phone String?

  passwordHash String

  profileImage String?

  designation String?

  legacyDepartment String?

  status UserStatus @default(PENDING_VERIFICATION)

  isEmailVerified Boolean @default(false)

  isPhoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  teamId       String?
  departmentId String?
  branchId     String?

  team       Team?       @relation(fields: [teamId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])

  queueMembers QueueMember[]
  commissions  Commission[]

  roleId String

  role Role @relation(fields: [roleId], references: [id])

  jobRoleId String?
  jobRole   JobRole? @relation(fields: [jobRoleId], references: [id])

  managerId String?
  manager   User?   @relation("UserHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("UserHierarchy")

  workspacePreference WorkspacePreference?
  dashboardPreference String?

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  contactsCreated Contact[] @relation("ContactCreatedBy")

  contactsUpdated Contact[] @relation("ContactUpdatedBy")

  accountsCreated Account[] @relation("AccountCreatedBy")

  accountsUpdated Account[] @relation("AccountUpdatedBy")

  leadsAssigned Lead[] @relation("LeadAssignedTo")
  leadsManaged  Lead[] @relation("LeadAssignedManager")

  leadsCreated Lead[] @relation("LeadCreatedBy")

  leadsUpdated Lead[] @relation("LeadUpdatedBy")

  stageHistoryPerformer LeadStageHistory[] @relation("StageHistoryUser")
  assignmentsReceived   LeadAssignment[]   @relation("AssignmentToUser")
  assignmentsGiven      LeadAssignment[]   @relation("AssignmentByUser")
  referralsAssigned     Referral[]         @relation("ReferralAssignedTo")
  salesTargets          SalesTarget[]
  salesPerformances     SalesPerformance[]
  callLogs              CallLog[]
  meetingLogs           MeetingLog[]

  notesCreated Note[] @relation("NoteCreatedBy")

  activitiesCreated Activity[] @relation("ActivityCreatedBy")

  activitiesAssigned Activity[] @relation("ActivityAssignedTo")

  quotationsCreated Quotation[] @relation("QuotationCreatedBy")

  quotationsUpdated Quotation[] @relation("QuotationUpdatedBy")

  quotationVersionsCreated QuotationVersion[] @relation("QuotationVersionCreatedBy")

  quotationHistoriesCreated QuotationHistory[] @relation("QuotationHistoryCreatedBy")

  policiesCreated Policy[] @relation("PolicyCreatedBy")

  policiesUpdated Policy[] @relation("PolicyUpdatedBy")

  policyHistoriesCreated    PolicyHistory[]         @relation("PolicyHistoryCreatedBy")
  claimsCreated             Claim[]                 @relation("ClaimCreatedBy")
  claimsUpdated             Claim[]                 @relation("ClaimUpdatedBy")
  claimHistoriesCreated     ClaimHistory[]          @relation("ClaimHistoryCreatedBy")
  claimCommunicationsSent   ClaimCommunication[]    @relation("ClaimCommunicationSender")
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  renewalTasks              RenewalTask[]
  uploadedDocuments         Document[]              @relation("DocumentUploadedBy")
  documentAccessLogs        DocumentAccessLog[]
  submittedProposals        Proposal[]              @relation("ProposalSubmittedBy")
  reviewedProposals         Proposal[]              @relation("ProposalReviewedBy")
  approvedProposals         Proposal[]              @relation("ProposalApprovedBy")
  requestedEndorsements     Endorsement[]           @relation("EndorsementRequestedBy")
  approvedEndorsements      Endorsement[]           @relation("EndorsementApprovedBy")
  proposalHistories         ProposalHistory[]
  endorsementHistories      EndorsementHistory[]
  vehiclesCreated           Vehicle[]               @relation("VehicleCreatedBy")
  savedReports              SavedReport[]           @relation("SavedReportCreatedBy")
  reportRuns                ReportRun[]             @relation("ReportRunTriggeredBy")
  kpiDefinitions            KpiDefinition[]         @relation("KpiDefinitionCreatedBy")
  reportsCreated            Report[]                @relation("ReportCreatedBy")
  reportsUpdated            Report[]                @relation("ReportUpdatedBy")
  reportExecutionsRequested ReportExecution[]       @relation("ReportExecutionRequestedBy")
  savedFilters              SavedFilter[]
  favoriteReports           FavoriteReport[]
  workflowHistories         WorkflowHistory[]
  workflowAssignments       WorkflowAssignment[]
  saodVerifications         SaodTpVerification[]    @relation("SaodVerifiedBy")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([email])
  @@index([employeeCode])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId])
  @@index([teamId])
  @@index([departmentId])
  @@index([roleId])
  @@index([jobRoleId])
  @@index([managerId])
  @@map("users")
}

//////////////////////////////////////////////////////////
// REFRESH TOKENS
//////////////////////////////////////////////////////////

model RefreshToken {
  id String @id @default(uuid())

  tokenHash String

  ipAddress String?

  userAgent String?

  expiresAt DateTime

  revokedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

//////////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid())

  action AuditAction

  entity String

  entityId String

  oldValue Json?

  newValue Json?

  ipAddress String?

  userAgent String?

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  performedById String?

  entityType String?

  metadata Json?

  correlationId String?

  module String?

  createdAt DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@index([correlationId])
  @@map("audit_logs")
}

//////////////////////////////////////////////////////////
// CONTACTS
//////////////////////////////////////////////////////////

model Contact {
  id String @id @default(uuid())

  contactCode String @unique

  type ContactType

  firstName String

  middleName String?

  lastName String

  gender Gender?

  dateOfBirth DateTime?

  companyName String?

  email String?

  phone String

  alternatePhone String?

  whatsappNumber String?

  occupation String?

  panNumber String?

  aadhaarNumber String?

  gstNumber String?

  accountId String?

  account Account? @relation(fields: [accountId], references: [id])

  leads Lead[]

  quotations Quotation[]

  policies  Policy[]
  claims    Claim[]
  proposals Proposal[]

  createdById String?

  updatedById String?

  createdBy User? @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedBy User? @relation("ContactUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  analytics      CustomerAnalytics?
  communications CommunicationLog[]
  familyMembers  FamilyMember[]
  vehicles       Vehicle[]

  @@index([phone])
  @@index([email])
  @@index([contactCode])
  @@index([accountId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("contacts")
}

//////////////////////////////////////////////////////////
// ACCOUNTS
//////////////////////////////////////////////////////////

model Account {
  id String @id @default(uuid())

  accountCode String @unique

  name String

  type AccountType

  industry String?

  website String?

  email String?

  phone String?

  gstNumber String?

  panNumber String?

  annualRevenue Decimal?

  employeeCount Int?

  description String?

  status Boolean @default(true)

  preferredCommunication CommunicationChannel @default(EMAIL)

  preferredLanguage String?

  kycStatus KycStatus @default(PENDING)

  kycCompletedAt DateTime?

  contacts Contact[]

  leads Lead[]

  quotations Quotation[]

  policies Policy[]
  claims   Claim[]

  createdById String?

  updatedById String?

  createdBy User? @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedBy User? @relation("AccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([accountCode])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("accounts")
}

//////////////////////////////////////////////////////////
// LEADS
//////////////////////////////////////////////////////////

model Lead {
  id          String     @id @default(uuid())
  leadCode    String     @unique
  title       String
  source      LeadSource @default(DIGITAL)
  status      LeadStatus @default(NEW)
  description String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  createdById String?
  updatedById String?
  createdBy   User?   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  score           Int       @default(0)
  priority        String? // 'HIGH', 'MEDIUM', 'LOW'
  firstResponseAt DateTime?
  slaStatus       String? // 'IN_SLA', 'BREACHED', 'COMPLETED'
  isDuplicate     Boolean   @default(false)
  duplicateOfId   String?
  duplicateOf     Lead?     @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates      Lead[]    @relation("LeadDuplicates")

  currentWorkflowStep String    @default("ASSIGNED") // ASSIGNED, CONTACTED, NEED_ANALYSIS, QUOTATION, PROPOSAL, NEGOTIATION, PAYMENT, ISSUED, REFERRAL, CRM_UPDATED
  crmUpdatedAt        DateTime?
  nextFollowup        DateTime?
  estimatedPremium    Decimal?  @db.Decimal(12, 2)
  noReferralReason    String?

  assignedManagerId String?
  assignedManager   User?   @relation("LeadAssignedManager", fields: [assignedManagerId], references: [id])

  notes      Note[]
  activities Activity[]

  quotations Quotation[]

  stageHistory         LeadStageHistory[]
  assignments          LeadAssignment[]
  referrals            Referral[]         @relation("LeadSourceReferrals")
  createdFromReferrals Referral[]         @relation("LeadCreatedReferral")
  callLogs             CallLog[]
  meetingLogs          MeetingLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([leadCode])
  @@index([status])
  @@index([currentWorkflowStep])
  @@index([contactId])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([accountId])
  @@index([createdById])
  @@index([status, assignedToId])
  @@index([updatedById])
  @@index([duplicateOfId])
  @@index([assignedManagerId])
  @@map("leads")
}

model LeadStageHistory {
  id               String   @id @default(uuid())
  leadId           String
  fromStage        String
  toStage          String
  performedById    String
  performerRole    String
  isOverride       Boolean  @default(false)
  overrideReason   String?
  remarks          String?
  prerequisitesMet Json?
  createdAt        DateTime @default(now())

  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User @relation("StageHistoryUser", fields: [performedById], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@index([performedById])
  @@map("lead_stage_history")
}

model LeadAssignment {
  id           String   @id @default(uuid())
  leadId       String
  assignedToId String
  assignedById String
  reason       String?
  assignedAt   DateTime @default(now())

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignmentToUser", fields: [assignedToId], references: [id])
  assignedBy User @relation("AssignmentByUser", fields: [assignedById], references: [id])

  @@index([leadId])
  @@index([assignedToId])
  @@index([assignedById])
  @@map("lead_assignments")
}

model Referral {
  id                String   @id @default(uuid())
  sourceLeadId      String?
  referrerContactId String?
  referralName      String
  phone             String
  email             String?
  relationship      String?
  interestedProduct String?
  status            String   @default("NEW") // NEW, CONTACTED, CONVERTED, REJECTED
  assignedToId      String?
  createdLeadId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sourceLead  Lead? @relation("LeadSourceReferrals", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  createdLead Lead? @relation("LeadCreatedReferral", fields: [createdLeadId], references: [id], onDelete: SetNull)
  assignedTo  User? @relation("ReferralAssignedTo", fields: [assignedToId], references: [id])

  @@index([sourceLeadId])
  @@index([phone])
  @@index([referrerContactId])
  @@index([assignedToId])
  @@index([createdLeadId])
  @@map("referrals")
}

model SalesTarget {
  id                   String   @id @default(uuid())
  userId               String
  year                 Int
  month                Int
  targetGwp            Decimal  @db.Decimal(12, 2)
  targetPolicies       Int
  targetConversionRate Decimal  @default(30.0) @db.Decimal(5, 2)
  achievedGwp          Decimal  @default(0) @db.Decimal(12, 2)
  achievedPolicies     Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@map("sales_targets")
}

model SalesPerformance {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @default(now())
  leadsAssigned   Int      @default(0)
  callsMade       Int      @default(0)
  meetingsHeld    Int      @default(0)
  quotesGenerated Int      @default(0)
  proposalsSent   Int      @default(0)
  policiesIssued  Int      @default(0)
  totalRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId])
  @@map("sales_performance")
}

model CallLog {
  id                String    @id @default(uuid())
  leadId            String?
  contactId         String?
  userId            String
  callType          String    @default("OUTBOUND") // OUTBOUND, INBOUND
  callOutcome       String // CONNECTED, NO_ANSWER, BUSY, SCHEDULED_CALLBACK, INTERESTED, NOT_INTERESTED
  durationSeconds   Int       @default(0)
  notes             String?
  scheduledFollowup DateTime?
  createdAt         DateTime  @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([contactId])
  @@map("call_logs")
}

model MeetingLog {
  id          String    @id @default(uuid())
  leadId      String?
  contactId   String?
  userId      String
  meetingType String    @default("IN_PERSON") // IN_PERSON, ONLINE_DEMO
  location    String?
  status      String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  scheduledAt DateTime
  completedAt DateTime?
  summary     String?
  createdAt   DateTime  @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([contactId])
  @@map("meeting_logs")
}

//////////////////////////////////////////////////////////
// NOTES
//////////////////////////////////////////////////////////

model Note {
  id      String @id @default(uuid())
  content String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([leadId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("notes")
}

//////////////////////////////////////////////////////////
// ACTIVITIES
//////////////////////////////////////////////////////////

model Activity {
  id          String         @id @default(uuid())
  type        ActivityType
  subject     String
  description String?
  status      ActivityStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])

  createdById String?
  createdBy   User?   @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([leadId])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([createdById])
  @@map("activities")
}

enum MotorWorkflowState {
  LEAD_CREATED
  CUSTOMER_CAPTURED
  VEHICLE_CAPTURED
  PREVIOUS_POLICY_CAPTURED
  POLICY_TYPE_SELECTED
  RULES_EVALUATED
  INSPECTION_REQUIRED
  INSPECTION_COMPLETED
  QUOTE_FINALIZED
  PAYMENT_PENDING
  PAYMENT_UNDER_PROCESS
  PAYMENT_DONE
  DOCUMENT_CHECK
  POLICY_CREATED
  ACTIVE
  RENEWAL
}

enum NcbResetReason {
  CLAIM_IN_PREVIOUS_YEAR
  OWNERSHIP_TRANSFER
  POLICY_EXPIRED_MORE_THAN_90_DAYS
  ELIGIBLE
}

enum InspectionStatus {
  NOT_REQUIRED
  REQUIRED
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum InspectionConductedBy {
  JEST_TEAM
  INSURER_EMPLOYEE
  CUSTOMER_SELF
  AGENT
  INSPECTION_AGENCY
}

enum PaymentTrackingStatus {
  NOT_DONE
  UNDER_PROCESS
  PAID
}

enum PreviousPolicyType {
  COMPREHENSIVE
  THIRD_PARTY
  SAOD
  NOT_AVAILABLE
}

//////////////////////////////////////////////////////////
// QUOTATIONS
//////////////////////////////////////////////////////////

model Quotation {
  id            String          @id @default(uuid())
  quotationCode String          @unique
  title         String
  status        QuotationStatus @default(DRAFT)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  insurerName    String
  insurerId      String?
  productCode    String?
  productType    String
  sumInsured     Decimal
  basePremium    Decimal
  gstAmount      Decimal
  totalPremium   Decimal
  ncbPercentage  Int      @default(0)
  discountAmount Decimal  @default(0)
  expiryDate     DateTime

  // Motor Insurance — Vehicle & Policy Data Capture
  // PRD §6.5: One unified Vehicle entity with categorySpecificData — NOT 8 separate models
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  vehicleCategory    VehicleCategory?
  policyType         String? // THIRD_PARTY_ONLY | STANDALONE_OD | PACKAGE_COMPREHENSIVE
  registrationNumber String? // Denormalized from vehicle for quick lookup
  motorMetadata      Json? // Policy-type-specific premium/commission data (TP/SAOD/Package)
  policyTenure       Int              @default(1)

  // SAOD Eligibility Verification Fields
  activeTpInsurer      String?
  activeTpPolicyNumber String?
  activeTpExpiryDate   DateTime?

  // Snapshot & Issuance
  calculationSnapshot      Json?
  calculationVersion       String?
  rateConfigurationVersion Int?
  issuanceStatus           IssuanceStatus @default(DRAFT)

  createdById String?
  updatedById String?
  createdBy   User?   @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("QuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  versions         QuotationVersion[]
  addons           QuotationAddon[]
  discounts        QuotationDiscount[]
  histories        QuotationHistory[]
  documents        QuotationDocument[]
  saodVerification SaodTpVerification?

  policy   Policy?
  proposal Proposal?

  // Motor workflow state machine
  workflowState MotorWorkflowState?

  // Motor module relations
  motorPreviousPolicy MotorPreviousPolicy?
  motorInspection     MotorInspection?
  motorPaymentRecord  MotorPaymentRecord?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([quotationCode])
  @@index([status])
  @@index([deletedAt])
  @@index([contactId])
  @@index([leadId])
  @@index([accountId])
  @@index([createdById])
  @@index([updatedById])
  @@index([vehicleId])
  @@map("quotations")
}

model QuotationVersion {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  versionNumber  Int
  sumInsured     Decimal
  basePremium    Decimal
  gstAmount      Decimal
  totalPremium   Decimal
  discountAmount Decimal
  metadata       Json?

  createdById String?
  createdBy   User?   @relation("QuotationVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([quotationId, versionNumber])
  @@index([quotationId])
  @@index([createdById])
  @@map("quotation_versions")
}

model QuotationAddon {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  addonCode   AddonCode
  addonName   String
  premium     Decimal
  description String?

  @@index([quotationId])
  @@map("quotation_addons")
}

model QuotationDiscount {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  discountType String
  percentage   Decimal?
  amount       Decimal
  description  String?

  @@index([quotationId])
  @@map("quotation_discounts")
}

model QuotationComparison {
  id             String  @id @default(uuid())
  comparisonCode String  @unique
  leadId         String?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([comparisonCode])
  @@index([leadId])
  @@map("quotation_comparisons")
}

model QuotationHistory {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status      String
  comments    String?

  createdById String?
  createdBy   User?   @relation("QuotationHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@index([createdById])
  @@map("quotation_histories")
}

model QuotationDocument {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  documentType String
  fileKey      String
  fileName     String
  fileSize     Int

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@map("quotation_documents")
}

//////////////////////////////////////////////////////////
// POLICIES
//////////////////////////////////////////////////////////

model Policy {
  id           String       @id @default(uuid())
  policyNumber String       @unique
  status       PolicyStatus @default(DRAFT)

  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  premiumAmount Decimal
  effectiveDate DateTime
  expiryDate    DateTime
  policyTenure  Int      @default(1)

  // Actual Policy Capture
  actualPolicyNumber     String?
  issueDate              DateTime?
  startDate              DateTime?
  endDate                DateTime?
  odStartDate            DateTime?
  odExpiryDate           DateTime?
  tpStartDate            DateTime?
  tpExpiryDate           DateTime?
  actualPremium          Decimal?
  paymentStatus          PaymentStatus?
  verificationStatus     DocumentVerificationStatus?
  issuedPolicyDocumentId String?

  // PRD §6.5: Unified Vehicle entity - vehicleId replaces 8 separate MotorDetail FKs
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Motor Policy Type & SAOD Eligibility (transaction-specific, stays on Policy)
  vehicleCategory      VehicleCategory?
  policyType           String?
  motorMetadata        Json? // Policy-type-specific premium/commission data
  activeTpInsurer      String?
  activeTpPolicyNumber String?
  activeTpExpiryDate   DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  members      PolicyMember[]
  nominees     PolicyNominee[]
  renewals     PolicyRenewal[]
  payments     PolicyPayment[]
  documents    PolicyDocument[]
  histories    PolicyHistory[]
  claims       Claim[]
  renewalTasks RenewalTask[]
  proposalId   String?          @unique
  proposal     Proposal?        @relation(fields: [proposalId], references: [id])
  endorsements Endorsement[]
  insurerDetail InsurerPolicyDetail?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([policyNumber])
  @@index([status])
  @@index([contactId])
  @@index([expiryDate])
  @@index([accountId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([status, expiryDate])
  @@index([quotationId])
  @@index([updatedById])
  @@index([proposalId])
  @@index([vehicleId])
  @@map("policies")
}

model InsurerPolicyDetail {
  id                  String    @id @default(uuid())
  policyId            String    @unique
  policy              Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  insurerPolicyNumber String?
  insurerQuoteId      String?
  insurerProposalId   String?
  submissionPayload   Json?
  responsePayload     Json?
  issuedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([policyId])
  @@index([insurerPolicyNumber])
  @@map("insurer_policy_details")
}

model PolicyMember {
  id          String   @id @default(uuid())
  policyId    String
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  relation    String
  dateOfBirth DateTime

  @@index([policyId])
  @@map("policy_members")
}

model PolicyNominee {
  id         String  @id @default(uuid())
  policyId   String
  policy     Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  relation   String
  percentage Decimal

  @@index([policyId])
  @@map("policy_nominees")
}

model PolicyRenewal {
  id             String   @id @default(uuid())
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  renewalNumber  Int
  previousExpiry DateTime
  newExpiry      DateTime
  premiumAmount  Decimal
  createdAt      DateTime @default(now())

  @@unique([policyId, renewalNumber])
  @@index([policyId])
  @@map("policy_renewals")
}

model PolicyPayment {
  id            String        @id @default(uuid())
  policyId      String
  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Restrict)
  amount        Decimal
  paymentDate   DateTime      @default(now())
  transactionId String        @unique
  paymentMethod String
  status        PaymentStatus @default(SUCCESS)

  @@index([policyId])
  @@index([transactionId])
  @@map("policy_payments")
}

model PolicyDocument {
  id           String   @id @default(uuid())
  policyId     String
  policy       Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  documentType String
  fileKey      String
  fileName     String
  fileSize     Int
  createdAt    DateTime @default(now())

  @@index([policyId])
  @@map("policy_documents")
}

model PolicyHistory {
  id       String  @id @default(uuid())
  policyId String
  policy   Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  status   String
  comments String?

  createdById String?
  createdBy   User?   @relation("PolicyHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([policyId])
  @@index([createdById])
  @@map("policy_histories")
}

//////////////////////////////////////////////////////////
// CLAIMS MANAGEMENT ENGINE
//////////////////////////////////////////////////////////

enum ClaimStatus {
  REPORTED
  REGISTERED
  SURVEYOR_ASSIGNED
  UNDER_ASSESSMENT
  APPROVED
  REJECTED
  PAYMENT_PENDING
  SETTLED
  CLOSED
}

model Claim {
  id          String      @id @default(uuid())
  claimNumber String      @unique
  status      ClaimStatus @default(REPORTED)

  policyId String
  policy   Policy @relation(fields: [policyId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  incidentDate   DateTime
  reportedDate   DateTime @default(now())
  description    String
  claimAmount    Decimal
  approvedAmount Decimal?

  surveyorName    String?
  surveyorDetails String?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("ClaimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("ClaimUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  documents      ClaimDocument[]
  histories      ClaimHistory[]
  communications ClaimCommunication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([claimNumber])
  @@index([status])
  @@index([policyId])
  @@index([contactId])
  @@index([incidentDate])
  @@index([accountId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("claims")
}

model ClaimDocument {
  id           String  @id @default(uuid())
  claimId      String
  claim        Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentType String
  fileKey      String
  fileName     String
  fileSize     Int
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([claimId])
  @@index([uploadedById])
  @@map("claim_documents")
}

model ClaimHistory {
  id          String      @id @default(uuid())
  claimId     String
  claim       Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  status      ClaimStatus
  action      String
  comments    String?
  createdById String?
  createdBy   User?       @relation("ClaimHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([claimId])
  @@index([createdById])
  @@map("claim_histories")
}

model ClaimCommunication {
  id        String               @id @default(uuid())
  claimId   String
  claim     Claim                @relation(fields: [claimId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?                @relation("ClaimCommunicationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient String
  channel   CommunicationChannel
  subject   String?
  body      String
  sentAt    DateTime             @default(now())

  @@index([claimId])
  @@index([senderId])
  @@map("claim_communications")
}

//////////////////////////////////////////////////////////
// NOTIFICATIONS & RENEWALS
//////////////////////////////////////////////////////////

enum NotificationType {
  SYSTEM
  LEAD_ASSIGNED
  LEAD_UPDATED
  FOLLOW_UP_DUE
  QUOTATION_CREATED
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  POLICY_ISSUED
  POLICY_CANCELLED
  POLICY_RENEWAL_45
  POLICY_RENEWAL_30
  POLICY_RENEWAL_20
  CLAIM_REGISTERED
  CLAIM_ASSIGNED
  CLAIM_APPROVED
  CLAIM_SETTLED
  DOCUMENT_UPLOADED
  ENDORSEMENT_APPROVED
}

enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum RenewalTaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Notification {
  id         String                @id @default(uuid())
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority  @default(MEDIUM)
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId   String?
  entityType String?
  actionUrl  String?
  icon       String?
  color      String?
  expiresAt  DateTime?
  isRead     Boolean               @default(false)
  readAt     DateTime?
  createdAt  DateTime              @default(now())
  histories  NotificationHistory[]

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([entityId])
  @@map("notifications")
}

model NotificationTemplate {
  id        String           @id @default(uuid())
  name      String           @unique
  type      NotificationType
  channel   String           @default("IN_APP")
  subject   String?
  body      String
  variables Json?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notification_templates")
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp     Boolean  @default(true)
  email     Boolean  @default(false)
  sms       Boolean  @default(false)
  whatsapp  Boolean  @default(false)
  renewals  Boolean  @default(true)
  claims    Boolean  @default(true)
  policies  Boolean  @default(true)
  leads     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification_preferences")
}

model NotificationHistory {
  id             String             @id @default(uuid())
  notificationId String
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         NotificationStatus @default(SENT)
  channel        String             @default("IN_APP")
  sentAt         DateTime           @default(now())
  failureReason  String?

  @@index([notificationId])
  @@map("notification_histories")
}

model RenewalTask {
  id         String               @id @default(uuid())
  policyId   String
  policy     Policy               @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId    String
  agent      User                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dueDate    DateTime
  offsetDays Int                  @default(30)
  status     RenewalTaskStatus    @default(PENDING)
  priority   NotificationPriority @default(MEDIUM)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([policyId, offsetDays])
  @@index([policyId])
  @@index([agentId])
  @@index([status])
  @@index([dueDate])
  @@index([agentId, status])
  @@map("renewal_tasks")
}

//////////////////////////////////////////////////////////
// SECURE DOCUMENT MANAGEMENT
//////////////////////////////////////////////////////////

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DocumentAccessAction {
  VIEW
  DOWNLOAD
  DELETE
  RESTORE
}

model Document {
  id                 String                     @id @default(uuid())
  documentNumber     String                     @unique
  name               String
  originalFileName   String
  mimeType           String
  size               Int
  storageKey         String
  storageProvider    String
  hash               String
  entityType         String
  entityId           String
  uploadedById       String
  uploadedBy         User                       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  status             DocumentStatus             @default(ACTIVE)
  version            Int                        @default(1)
  verificationStatus DocumentVerificationStatus @default(PENDING)
  expiryDate         DateTime?
  tags               String[]                   @default([])
  metadata           Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions             DocumentVersion[]
  accessLogs           DocumentAccessLog[]
  proposalDocuments    ProposalDocument[]
  endorsementDocuments EndorsementDocument[]

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([documentNumber])
  @@index([entityId])
  @@index([deletedAt])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String
  originalFileName String
  size             Int
  hash             String
  uploadedAt       DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentAccessLog {
  id         String               @id @default(uuid())
  documentId String
  document   Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     DocumentAccessAction
  ipAddress  String?
  createdAt  DateTime             @default(now())

  @@index([documentId])
  @@index([userId])
  @@map("document_access_logs")
}

//////////////////////////////////////////////////////////
// MOTOR ADMINISTRATION & RATING RULES
//////////////////////////////////////////////////////////

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER
  COMMERCIAL_GCV
  TRACTOR
  AUTO_RICKSHAW
  TAXI
  BUS_COACH
  MISC_CLASS_D
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum RatingRuleType {
  BASE_RATE
  AGE_LOADING
  NCB_DISCOUNT
  OD_DISCOUNT
  TP_DISCOUNT
  NCB_RESET
  ADDON_RATE
  TAX_RATE
}

enum AddonCode {
  ZERO_DEP
  ENGINE_PROTECT
  RSA
  RTI
  CONSUMABLES
  NCB_PROTECT
  PASSENGER_COVER
  OTHER
}

model VehicleCategoryDocument {
  id           String      @id @default(uuid())
  vehicleType  VehicleType
  documentName String
  isMandatory  Boolean     @default(true)
  phase        String?
  displayOrder Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleType])
  @@map("vehicle_category_documents")
}

enum ProductType {
  THIRD_PARTY_ONLY
  STANDALONE_OWN_DAMAGE
  PACKAGE_COMPREHENSIVE
}

model VehicleManufacturer {
  id        String         @id @default(uuid())
  name      String         @unique
  code      String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]

  @@map("vehicle_manufacturers")
}

model VehicleModel {
  id             String              @id @default(uuid())
  manufacturerId String
  manufacturer   VehicleManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  name           String
  code           String              @unique
  vehicleType    VehicleType         @default(FOUR_WHEELER)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  variants       VehicleVariant[]

  @@index([manufacturerId])
  @@map("vehicle_models")
}

model VehicleVariant {
  id               String           @id @default(uuid())
  modelId          String
  model            VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name             String
  code             String           @unique
  fuelType         FuelType         @default(PETROL)
  transmissionType TransmissionType @default(MANUAL)
  engineCapacity   Int
  exShowroomPrice  Decimal
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([modelId])
  @@map("vehicle_variants")
}

model RtoMaster {
  id            String   @id @default(uuid())
  code          String   @unique
  state         String
  district      String
  rtoOfficeName String
  rtoZone       String   @default("ZONE_A") // ZONE_A, ZONE_B
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([state])
  @@map("rto_masters")
}

model Insurer {
  id                      String   @id @default(uuid())
  name                    String   @unique
  code                    String   @unique
  logoUrl                 String?
  irdaiRegistrationNumber String?
  contactEmail            String?
  contactPhone            String?
  address                 String?
  rating                  Decimal?
  supportedVehicleTypes   Json?
  supportedPolicyTypes    Json?
  supportedAddons         Json?
  supportsZeroDep         Boolean  @default(true)
  supportsRTI             Boolean  @default(true)
  supportsEngineProtect   Boolean  @default(true)
  supportsRSA             Boolean  @default(true)
  supportsNCBProtection   Boolean  @default(true)
  supportsConsumables     Boolean  @default(true)
  supportsKeyProtect      Boolean  @default(true)
  supportsTyreProtect     Boolean  @default(true)
  isActive                Boolean  @default(true)
  contactDetails          Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  rules                 RatingRule[]
  products              InsuranceProduct[]
  discountRules         DiscountRule[]
  commissionMatrices    CommissionMatrix[]
  underwritingQuestions UnderwritingQuestion[]
  addonRules            AddOnRule[]

  @@map("insurers")
}

model InsuranceProduct {
  id          String   @id @default(uuid())
  insurerId   String
  productName String
  code        String   @unique
  vehicleType String   @default("FOUR_WHEELER")
  policyType  String   @default("COMPREHENSIVE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([insurerId])
  @@map("insurance_products")
}

model DiscountRule {
  id                              String   @id @default(uuid())
  insurerId                       String
  vehicleType                     String   @default("FOUR_WHEELER")
  policyType                      String   @default("COMPREHENSIVE")
  maxDiscountPercent              Decimal  @default(70.0) @db.Decimal(5, 2)
  minDiscountPercent              Decimal  @default(0.0) @db.Decimal(5, 2)
  managerApprovalThresholdPercent Decimal  @default(15.0) @db.Decimal(5, 2)
  isActive                        Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([insurerId])
  @@map("discount_rules")
}

model CommissionMatrix {
  id                  String   @id @default(uuid())
  insurerId           String
  productType         String   @default("MOTOR")
  odCommissionPercent Decimal  @default(15.0) @db.Decimal(5, 2)
  tpCommissionPercent Decimal  @default(2.5) @db.Decimal(5, 2)
  brokeragePercent    Decimal  @default(17.5) @db.Decimal(5, 2)
  tdsPercent          Decimal  @default(5.0) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([insurerId])
  @@map("commission_matrices")
}

model UnderwritingQuestion {
  id           String   @id @default(uuid())
  insurerId    String
  questionText String
  answerType   String   @default("BOOLEAN") // BOOLEAN, TEXT, NUMBER, SELECT
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([insurerId])
  @@map("underwriting_questions")
}

model AddOnRule {
  id                 String   @id @default(uuid())
  insurerId          String
  addonCode          String
  addonName          String
  maxVehicleAgeYears Int      @default(5)
  allowedFuelTypes   Json?
  premiumFormula     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([insurerId])
  @@map("add_on_rules")
}

model Product {
  id                 String       @id @default(uuid())
  name               String
  code               String       @unique
  type               ProductType
  baseCommissionRate Decimal
  description        String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  rules              RatingRule[]

  @@map("products")
}

model RatingRule {
  id                  String         @id @default(uuid())
  productId           String
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  insurerId           String
  insurer             Insurer        @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  ruleName            String
  ruleType            RatingRuleType
  eligibilityCriteria Json
  formulaOrRate       Json
  priority            Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([productId])
  @@index([insurerId])
  @@index([productId, insurerId, isActive])
  @@map("rating_rules")
}

//////////////////////////////////////////////////////////
// PROPOSALS & UNDERWRITING
//////////////////////////////////////////////////////////

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENT_PENDING
  APPROVED
  REJECTED
  POLICY_ISSUED
}

model Proposal {
  id             String         @id @default(uuid())
  proposalNumber String         @unique
  quotationId    String         @unique
  quotation      Quotation      @relation(fields: [quotationId], references: [id])
  contactId      String
  contact        Contact        @relation(fields: [contactId], references: [id])
  status         ProposalStatus @default(DRAFT)
  remarks        String?
  submittedById  String
  submittedBy    User           @relation("ProposalSubmittedBy", fields: [submittedById], references: [id])
  reviewedById   String?
  reviewedBy     User?          @relation("ProposalReviewedBy", fields: [reviewedById], references: [id])
  approvedById   String?
  approvedBy     User?          @relation("ProposalApprovedBy", fields: [approvedById], references: [id])
  rejectedReason String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  version        Int            @default(1)

  documents ProposalDocument[]
  histories ProposalHistory[]
  policy    Policy?

  @@index([quotationId])
  @@index([contactId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([approvedById])
  @@map("proposals")
}

model ProposalDocument {
  id         String    @id @default(uuid())
  proposalId String
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  mandatory  Boolean   @default(true)
  verified   Boolean   @default(false)
  remarks    String?

  @@index([proposalId])
  @@index([documentId])
  @@map("proposal_documents")
}

model ProposalHistory {
  id            String         @id @default(uuid())
  proposalId    String
  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  status        ProposalStatus
  comments      String?
  performedById String
  performedBy   User           @relation(fields: [performedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([proposalId])
  @@index([performedById])
  @@map("proposal_histories")
}

//////////////////////////////////////////////////////////
// ENDORSEMENTS & ALTERATIONS
//////////////////////////////////////////////////////////

enum EndorsementType {
  CONTACT_CHANGE // Update contact personal details (name, email, phone)
  ADDRESS_CHANGE // Update communication address
  VEHICLE_CHANGE // Update vehicle identifiers (reg no, engine, chassis)
  IDV_CHANGE // Change Insured Declared Value (triggers premium recalc)
  NCB_CHANGE // NCB correction / reset
  COVERAGE_CHANGE // Add/remove add-ons or coverage riders
  NOMINEE_CHANGE // Update policy nominee details
  OWNER_TRANSFER // Transfer of ownership
  PREMIUM_CHANGE // General premium correction
}

enum EndorsementStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Endorsement {
  id                String            @id @default(uuid())
  endorsementNumber String            @unique
  policyId          String
  policy            Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  type              EndorsementType
  status            EndorsementStatus @default(REQUESTED)
  requestedById     String
  requestedBy       User              @relation("EndorsementRequestedBy", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?             @relation("EndorsementApprovedBy", fields: [approvedById], references: [id])
  reason            String
  requestedChanges  Json?
  validatedChanges  Json?
  effectiveDate     DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  documents EndorsementDocument[]
  histories EndorsementHistory[]

  @@index([policyId])
  @@index([requestedById])
  @@index([approvedById])
  @@map("endorsements")
}

model EndorsementDocument {
  id            String      @id @default(uuid())
  endorsementId String
  endorsement   Endorsement @relation(fields: [endorsementId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id])

  @@index([endorsementId])
  @@index([documentId])
  @@map("endorsement_documents")
}

model EndorsementHistory {
  id            String            @id @default(uuid())
  endorsementId String
  endorsement   Endorsement       @relation(fields: [endorsementId], references: [id], onDelete: Cascade)
  status        EndorsementStatus
  comments      String?
  performedById String
  performedBy   User              @relation(fields: [performedById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([endorsementId])
  @@index([performedById])
  @@map("endorsement_histories")
}

//////////////////////////////////////////////////////////
// REPORTING, BI & DATA WAREHOUSE
//////////////////////////////////////////////////////////

enum ReportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum KpiUnit {
  PERCENTAGE
  CURRENCY
  COUNT
  RATIO
  DAYS
}

enum ReportCategory {
  SALES
  UNDERWRITING
  CLAIMS
  POLICY
  CRM
  FINANCE
  AUDIT
  CUSTOM
}

model SavedReport {
  id          String         @id @default(uuid())
  name        String
  description String?
  category    ReportCategory
  dataSource  String // contacts | leads | policies | claims | renewals | revenue
  columns     Json // Array of column definition objects
  filters     Json // Array of filter definition objects
  sortBy      String?
  sortDir     String?        @default("asc")
  isBuiltIn   Boolean        @default(false)
  isActive    Boolean        @default(true)

  createdById String
  createdBy   User   @relation("SavedReportCreatedBy", fields: [createdById], references: [id])

  runs ReportRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([category])
  @@map("saved_reports")
}

model ReportRun {
  id             String          @id @default(uuid())
  savedReportId  String
  savedReport    SavedReport     @relation(fields: [savedReportId], references: [id], onDelete: Cascade)
  status         ReportRunStatus @default(PENDING)
  rowCount       Int?
  exportPath     String?
  errorMessage   String?
  appliedFilters Json?

  triggeredById String?
  triggeredBy   User?   @relation("ReportRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([savedReportId])
  @@index([status])
  @@index([triggeredById])
  @@map("report_runs")
}

model KpiDefinition {
  id           String  @id @default(uuid())
  name         String
  key          String  @unique
  description  String?
  formula      String // e.g. "policies_issued / leads_created * 100"
  category     String // revenue | sales | claims | renewals | operations
  unit         KpiUnit @default(COUNT)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdById String?
  createdBy   User?   @relation("KpiDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdById])
  @@map("kpi_definitions")
}

enum ReportModule {
  LEADS
  CONTACTS
  QUOTATIONS
  POLICIES
  CLAIMS
  REPORTS
}

enum ReportType {
  TABULAR
  SUMMARY
  CHART
  MATRIX
}

enum ReportStatus {
  ACTIVE
  INACTIVE
}

enum ReportFilterOperator {
  EQUALS
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  BETWEEN
  GREATER_THAN
  LESS_THAN
  IN
  NOT_IN
  NULL
  NOT_NULL
}

enum ReportExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Report {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  description String?
  category    ReportCategory
  module      ReportModule
  type        ReportType     @default(TABULAR)
  status      ReportStatus   @default(ACTIVE)
  version     Int            @default(1)
  isSystem    Boolean        @default(false)
  shared      Boolean        @default(false)

  parentId String?
  parent   Report?  @relation("ReportHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Report[] @relation("ReportHierarchy")

  // Statistics
  executionCount  Int       @default(0)
  lastExecutedAt  DateTime?
  averageDuration Float     @default(0.0)

  createdById String?
  createdBy   User?     @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("ReportUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  columns      ReportColumn[]
  filters      ReportFilter[]
  executions   ReportExecution[]
  schedules    ReportSchedule[]
  savedFilters SavedFilter[]
  favorites    FavoriteReport[]

  @@index([parentId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedAt])
  @@map("reports")
}

model ReportColumn {
  id            String  @id @default(uuid())
  reportId      String
  report        Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  field         String
  label         String
  type          String
  sortable      Boolean @default(true)
  filterable    Boolean @default(true)
  visible       Boolean @default(true)
  order         Int     @default(0)
  configuration Json?

  @@index([reportId])
  @@map("report_columns")
}

model ReportFilter {
  id           String               @id @default(uuid())
  reportId     String
  report       Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  field        String
  operator     ReportFilterOperator
  defaultValue Json?
  required     Boolean              @default(false)

  @@index([reportId])
  @@map("report_filters")
}

model ReportExecution {
  id            String                @id @default(uuid())
  reportId      String
  report        Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?                 @relation("ReportExecutionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  status        ReportExecutionStatus
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  duration      Int?
  filePath      String?
  recordCount   Int                   @default(0)
  parameters    Json?

  @@index([reportId])
  @@index([requestedById])
  @@map("report_executions")
}

model ReportSchedule {
  id             String                  @id @default(uuid())
  reportId       String
  report         Report                  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cronExpression String
  frequency      ReportScheduleFrequency
  timezone       String                  @default("UTC")
  active         Boolean                 @default(true)
  nextRun        DateTime?

  @@index([reportId])
  @@map("report_schedules")
}

model SavedFilter {
  id        String   @id @default(uuid())
  name      String
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters   Json // key-value pair of filter values passed by user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, reportId])
  @@index([reportId])
  @@index([userId])
  @@map("saved_report_filters")
}

model FavoriteReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reportId])
  @@index([userId])
  @@index([reportId])
  @@map("favorite_reports")
}

enum WorkflowModule {
  LEADS
  PROPOSALS
  ENDORSEMENTS
  POLICIES
  CLAIMS
  QUOTATIONS
}

enum WorkflowEntityType {
  LEAD
  PROPOSAL
  POLICY
  ENDORSEMENT
  CLAIM
  QUOTATION
}

enum WorkflowApprovalType {
  ANY
  ALL
  SEQUENTIAL
}

model Workflow {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  module      WorkflowModule
  description String?
  active      Boolean        @default(true)
  version     Int            @default(1)
  isSystem    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  states      WorkflowState[]
  transitions WorkflowTransition[]
  histories   WorkflowHistory[]

  @@index([deletedAt])
  @@map("workflows")
}

model WorkflowState {
  id               String   @id @default(uuid())
  workflowId       String
  workflow         Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name             String
  code             String
  isInitial        Boolean  @default(false)
  isTerminal       Boolean  @default(false)
  slaMinutes       Int?
  escalationRoleId String?

  incomingTransitions WorkflowTransition[] @relation("TransitionToState")
  outgoingTransitions WorkflowTransition[] @relation("TransitionFromState")
  assignments         WorkflowAssignment[]
  actions             WorkflowAction[]

  @@unique([workflowId, code])
  @@index([workflowId])
  @@index([escalationRoleId])
  @@map("workflow_states")
}

model WorkflowTransition {
  id          String         @id @default(uuid())
  workflowId  String
  workflow    Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStateId String?
  fromState   WorkflowState? @relation("TransitionFromState", fields: [fromStateId], references: [id], onDelete: SetNull)
  toStateId   String
  toState     WorkflowState  @relation("TransitionToState", fields: [toStateId], references: [id], onDelete: Cascade)
  name        String
  triggerType String         @default("MANUAL") // MANUAL, AUTOMATIC
  conditions  Json? // { "logic": "AND", "rules": [...] }

  assignments WorkflowAssignment[]
  actions     WorkflowAction[]

  @@index([workflowId])
  @@index([fromStateId])
  @@index([toStateId])
  @@map("workflow_transitions")
}

model WorkflowAction {
  id            String              @id @default(uuid())
  stateId       String?
  state         WorkflowState?      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  transitionId  String?
  transition    WorkflowTransition? @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  type          String // NOTIFICATION, EVENT, DOCUMENT_GENERATION, AUDIT
  configuration Json?

  @@index([stateId])
  @@index([transitionId])
  @@map("workflow_actions")
}

model WorkflowAssignment {
  id           String               @id @default(uuid())
  stateId      String?
  state        WorkflowState?       @relation(fields: [stateId], references: [id], onDelete: Cascade)
  transitionId String?
  transition   WorkflowTransition?  @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  roleId       String?
  role         Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId String?
  branchId     String?
  order        Int                  @default(0)
  required     Boolean              @default(true)
  approvalType WorkflowApprovalType @default(ANY)

  @@index([stateId])
  @@index([transitionId])
  @@index([roleId])
  @@index([userId])
  @@index([departmentId])
  @@index([branchId])
  @@map("workflow_assignments")
}

model WorkflowHistory {
  id              String             @id @default(uuid())
  workflowId      String
  workflow        Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion Int
  entityId        String
  entityType      WorkflowEntityType
  fromStateId     String?
  toStateId       String
  performedById   String?
  performedBy     User?              @relation(fields: [performedById], references: [id], onDelete: SetNull)
  comments        String?
  duration        Int? // In seconds
  result          Json?
  variables       Json?
  createdAt       DateTime           @default(now())

  @@index([workflowId])
  @@index([entityId])
  @@index([fromStateId])
  @@index([toStateId])
  @@index([performedById])
  @@map("workflow_histories")
}

enum JobType {
  NOTIFICATION
  RENEWAL
  REPORT
  WORKFLOW
  DOCUMENT
  AUDIT
  SEARCH
  EMAIL
  SMS
  WHATSAPP
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
  DELAYED
}

model BackgroundJob {
  id            String    @id @default(uuid())
  queue         String
  jobId         String?   @unique
  type          JobType
  status        JobStatus @default(QUEUED)
  payload       Json?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  startedAt     DateTime?
  completedAt   DateTime?
  error         String?   @db.Text
  createdBy     String?
  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queue, status])
  @@index([type])
  @@index([jobId])
  @@index([correlationId])
}

// ==========================================
// ORGANIZATION MANAGEMENT
// Hierarchy: Company -> Region -> Zone -> Branch -> Department -> Team
// ==========================================

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  logoUrl   String?
  address   String?
  taxId     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions Region[]

  @@index([taxId])
}

model Region {
  id        String   @id @default(uuid())
  companyId String
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  zones   Zone[]

  @@index([companyId])
}

model Zone {
  id        String   @id @default(uuid())
  regionId  String
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@index([regionId])
}

model Branch {
  id        String   @id @default(uuid())
  zoneId    String
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone        Zone         @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  departments Department[]
  users       User[]

  @@index([zoneId])
}

model Department {
  id           String   @id @default(uuid())
  branchId     String?
  name         String
  code         String   @unique
  description  String?
  displayOrder Int      @default(0)
  status       String   @default("ACTIVE")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  teams    Team[]
  users    User[]
  jobRoles JobRole[]

  @@index([branchId])
}

model JobRole {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  description     String?
  departmentId    String
  defaultRoleType RoleType @default(SALES_AGENT)
  parentRoleId    String?
  displayOrder    Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  parentRole JobRole?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  subRoles   JobRole[]           @relation("RoleHierarchy")
  users      User[]
  dashboards DashboardRegistry[]

  @@index([departmentId])
  @@index([parentRoleId])
}

model DashboardRegistry {
  id            String   @id @default(uuid())
  jobRoleId     String
  dashboardCode String   @unique
  workspaceCode String
  title         String
  subtitle      String?
  layout        Json
  navigation    Json
  widgets       Json
  quickActions  Json
  permissions   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobRole JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@index([jobRoleId])
}

model WorkspacePreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  theme           String   @default("system")
  layout          String   @default("default")
  favoriteWidgets Json?
  collapsedMenus  Json?
  language        String   @default("en")
  timezone        String   @default("Asia/Kolkata")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Team {
  id           String   @id @default(uuid())
  departmentId String
  name         String
  code         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users      User[]

  @@unique([departmentId, code])
  @@index([departmentId])
}

// ==========================================
// SYSTEM CONFIGURATION & FEATURE FLAGS
// ==========================================

model SystemConfig {
  key         String   @id
  value       String // JSON stringified value or scalar
  valueType   String // 'STRING', 'NUMBER', 'BOOLEAN', 'JSON'
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  isEnabled   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// NUMBERING ENGINE
// ==========================================

model NumberingFormat {
  entityType String   @id // e.g. 'POLICY', 'CLAIM', 'LEAD'
  prefix     String
  format     String // e.g. '{PREFIX}-{YYYY}-{MM}-{SEQUENCE}'
  padding    Int      @default(6) // e.g. 6 means 000001
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NumberingSequence {
  entityType String
  year       Int
  month      Int
  sequence   Int    @default(0)

  @@id([entityType, year, month])
}

// ==========================================
// LOOKUP FRAMEWORK (Hierarchical)
// ==========================================

model LookupCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values LookupValue[]
}

model LookupValue {
  id          String   @id @default(uuid())
  categoryId  String
  parentId    String?
  code        String
  name        String
  description String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category LookupCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent   LookupValue?   @relation("LookupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children LookupValue[]  @relation("LookupHierarchy")

  @@unique([categoryId, code])
  @@index([categoryId])
  @@index([parentId])
}

// ==========================================
// BUSINESS CALENDAR
// ==========================================

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime
  name      String
  isGlobal  Boolean  @default(true)
  branchId  String? // If not global, applies to specific branch
