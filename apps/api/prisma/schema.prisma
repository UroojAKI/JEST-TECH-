enum VehicleCategory {
  BIKE
  PRIVATE_CAR
  GCV
  TRACTOR
  AUTO
  TAXI
  BUS_COACH
  MISC_CLASS_D
}

enum MotorPolicyType {
  THIRD_PARTY_ONLY
  STANDALONE_OD
  PACKAGE_COMPREHENSIVE
}

//////////////////////////////////////////////////////////
// MOTOR VEHICLE — UNIFIED ENTITY (PRD §6.5)
// One Vehicle entity with categorySpecificData JSON.
// Replaces 8 separate MotorDetail models.
// 8 UI form configurations still render category-specific
// fields on the frontend — only the persistence is unified.
//////////////////////////////////////////////////////////

model Vehicle {
  id          String @id @default(uuid())
  vehicleCode String @unique // e.g. VEH-2026-001234

  // ── Core category discriminator ──
  status   VehicleStatus   @default(EXISTING)
  category VehicleCategory // BIKE | PRIVATE_CAR | GCV | TRACTOR | AUTO | TAXI | BUS_COACH | MISC_CLASS_D
  subtype  String?

  // ── Shared fields (common to all 8 Motor PDF A-sections) ──
  registrationNumber   String? // Blank for new vehicle
  makeModel            String? // Make & Model (+ Variant for Private Car)
  manufactureYearMonth String? // "MM/YYYY"
  dateOfRegistration   DateTime?
  engineNumber         String?
  chassisNumber        String?
  fuelType             String? // Petrol / Diesel / CNG / Electric / Hybrid
  rtoLocation          String?

  // ── Category-specific attributes (Motor PDF A-section fields per category) ──
  // BIKE:         { vehicleSubType, engineCapacityCcOrKw, usageType }
  // PRIVATE_CAR:  { vehicleSubType, engineCapacityCcOrKw, seatingCapacity, hypothecationFinancerName }
  // GCV:          { vehicleSubType, grossVehicleWeightKg, carryingCapacityTonnes, zoneOfOperation, usageType, routePermitType }
  // TRACTOR:      { horsePowerHp, attachmentUsed, usageType }
  // AUTO:         { vehicleSubType, seatingOrLoadCapacity }
  // TAXI:         { vehicleSubType, seatingCapacity, permitType, aggregatorAffiliation }
  // BUS_COACH:    { vehicleSubType, seatingCapacity, routePermitType, schoolBusComplianceCert }
  // MISC_CLASS_D: { vehicleSubType, purposeOfUse }
  categorySpecificData Json?

  // ── Ownership ──
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // ── Relations — one vehicle can have multiple quotations (multi-insurer comparison) ──
  quotations Quotation[]
  policies   Policy[]

  createdById String?
  createdBy   User?   @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([registrationNumber])
  @@index([contactId])
  @@index([category])
  @@index([vehicleCode])
  @@index([deletedAt])
  @@map("vehicles")
}

// Versioned IRDAI TP Tariff Configuration
// Populated ONLY from verified IRDAI notifications/circulars
// Do NOT populate with unverified tariff figures
model MotorTariff {
  id String @id @default(uuid())

  vehicleCategory    VehicleCategory
  vehicleSubCategory String? // e.g. "PRIVATE_CAR_NOT_FOR_HIRE"

  // Engine/Capacity Ranges (used for lookup)
  engineCcMin   Int? // Minimum CC (for CC-based tariff)
  engineCcMax   Int? // Maximum CC (null = no upper limit)
  seatingCapMin Int? // Minimum seating capacity
  seatingCapMax Int? // Maximum seating capacity
  gvwMin        Decimal? // Minimum GVW in kg
  gvwMax        Decimal? // Maximum GVW in kg

  // Tariff Data
  policyType    String // TP_ONLY | PACKAGE (TP component)
  annualPremium Decimal // Annual TP premium in INR

  // Versioning
  effectiveFrom    DateTime // Date this tariff becomes active
  effectiveTo      DateTime? // null = currently active
  source           String // e.g. "IRDAI Circular Ref No XYZ/2024"
  version          String // e.g. "2024-25", "2025-26"
  isActive         Boolean   @default(true)
  isVerified       Boolean   @default(false) // Must be set to true only after verifying against official IRDAI notification
  verificationNote String? // e.g. "Pending verification against IRDAI circular"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleCategory, effectiveFrom, isActive])
  @@map("motor_tariffs")
}

enum SaodVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SaodVerificationMethod {
  POLICY_DOCUMENT
  INSURER_PORTAL
  INSURER_CONFIRMATION
  OTHER
}

model SaodTpVerification {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  // Active TP Policy Details
  tpInsurer      String
  tpPolicyNumber String
  tpStartDate    DateTime
  tpExpiryDate   DateTime

  // Verification
  verificationStatus  SaodVerificationStatus  @default(PENDING)
  verificationMethod  SaodVerificationMethod?
  evidenceDocumentUrl String?
  verifierNotes       String?

  // Who / When
  verifiedById String?
  verifiedBy   User?     @relation("SaodVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saod_tp_verifications")
}

//////////////////////////////////////////////////////////
// RENEWAL CONFIGURATION
// Configurable look-ahead window and reminder offsets
// per policy type/category. Replaces hardcoded 60-day window.
//////////////////////////////////////////////////////////

model RenewalConfiguration {
  id              String  @id @default(uuid())
  name            String  @default("Default")
  policyType      String? // null = all; "MOTOR" | "HEALTH" | "LIFE"
  vehicleCategory String? // null = all; or specific VehicleCategory code
  lookAheadDays   Int     @default(60) // How far ahead to pull policies into queue
  reminderOffsets Int[]   @default([30, 7, 1]) // Days before expiry to fire reminders
  escalationDays  Int     @default(3) // Days past dueDate before task escalates
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("renewal_configurations")
}

model DocumentChecklistItem {
  id           String          @id @default(uuid())
  category     VehicleCategory
  documentName String
  condition    String? // e.g. "if financed", "if new vehicle"
  isMandatory  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

//////////////////////////////////////////////////////////
// MOTOR RULE ENGINE — PREVIOUS POLICY, EVALUATION,
// INSPECTION & PAYMENT TRACKING
//////////////////////////////////////////////////////////

model MotorPreviousPolicy {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  policyExpiryDate       DateTime?
  expiredMoreThan90Days  Boolean             @default(false) // auto-computed from expiryDate
  ownershipTransfer      Boolean             @default(false)
  previousPolicyType     PreviousPolicyType?
  previousInsurerName    String?
  previousPolicyNumber   String?
  previousOdInsurerName  String? // For SAOD: separate OD insurer
  previousOdPolicyNumber String? // For SAOD: separate OD policy
  odExpiryDate           DateTime? // OD policy expiry for SAOD
  tpExpiryDate           DateTime? // TP policy expiry (active TP for SAOD)
  claimInPreviousYear    Boolean             @default(false)
  policyTransferStatus   Boolean? // true = policy transferred to new owner
  rcTransferStatus       Boolean? // true = RC transferred
  newOwnerName           String?
  previousPolicyCopyUrl  String? // document reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleEvaluation MotorRuleEvaluation?

  @@map("motor_previous_policies")
}

model MotorRuleEvaluation {
  id               String              @id @default(uuid())
  quotationId      String              @unique
  previousPolicyId String              @unique
  previousPolicy   MotorPreviousPolicy @relation(fields: [previousPolicyId], references: [id], onDelete: Cascade)

  // Rule results — source of truth is always recalculated, this is the audit record
  inspectionRequired     Boolean        @default(false)
  inspectionReasons      String[] // e.g. ["POLICY_EXPIRED", "OWNERSHIP_TRANSFER"]
  ncb                    Decimal        @default(0)
  ncbReason              NcbResetReason @default(ELIGIBLE)
  eligibleNcb            Decimal        @default(0) // NCB that would apply without resets
  tpVerificationRequired Boolean        @default(false)
  policyTransferRequired Boolean        @default(false)
  saodTpValid            Boolean        @default(true)
  missingDocuments       String[]
  nextStep               String         @default("QUOTATION")

  // Full context snapshot for audit (input used to compute)
  evaluationContext Json

  evaluatedAt DateTime @default(now())

  @@map("motor_rule_evaluations")
}

model MotorInspection {
  id             String    @id @default(uuid())
  inspectionCode String    @unique
  quotationId    String    @unique
  quotation      Quotation @relation(fields: [quotationId], references: [id])

  status          InspectionStatus       @default(REQUIRED)
  conductedByType InspectionConductedBy?

  // Inspector details (context-sensitive)
  inspectorUserId     String? // For JEST_TEAM or AGENT — CRM user
  inspectorName       String?
  inspectorPhone      String?
  inspectorEmail      String?
  inspectorCompany    String?
  inspectorEmployeeId String?

  // Timing
  inspectionDate  DateTime?
  inspectionTime  String? // "HH:MM" format
  completedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // 7 photo evidence slots — each is a storage key/URL
  frontImageKey      String?
  backImageKey       String?
  leftImageKey       String?
  rightImageKey      String?
  windshieldImageKey String?
  chassisImageKey    String?
  odometerImageKey   String?

  // Generated inspection PDF
  reportPdfKey String?
  reportPdfUrl String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quotationId])
  @@index([status])
  @@map("motor_inspections")
}

model MotorPaymentRecord {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  status          PaymentTrackingStatus @default(NOT_DONE)
  amount          Decimal?
  paymentMethod   String? // Cash/Cheque/NEFT/UPI/Other
  referenceNumber String? // Cheque number / UTR / UPI ref
  paidAt          DateTime?
  notes           String?

  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([status])
  @@map("motor_payment_records")
}

model MotorRateConfiguration {
  id              String  @id @default(uuid())
  rateCategory    String // TP, OD, ADDON, GST, PA, DISCOUNT
  addonCode       String? // If rateCategory is ADDON
  insurerId       String?
  productCode     String?
  vehicleCategory String?
  vehicleSubType  String?
  policyType      String?

  pricingModel AddonRateType
  rateValue    Decimal?
  minAmount    Decimal?
  maxAmount    Decimal?
  gstRate      Decimal?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  version       Int       @default(1)
  isActive      Boolean   @default(true)

  sourceType      RateSourceType
  sourceReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rateCategory, isActive])
  @@index([addonCode])
  @@map("motor_rate_configurations")
}

//////////////////////////////////////////////////////////
// TRANSACTIONAL OUTBOX
//////////////////////////////////////////////////////////

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

