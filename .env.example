# ==============================================================================
# JEST POLICY CRM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env in local development and populate with secure values.
# NEVER commit the actual .env file or real secrets to source control.
# In production, all secrets must be at least 32 characters long and cryptographically random.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=4000
APP_NAME=JEST Policy CRM API

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jest_policy_crm?schema=public

# Authentication Secrets (Mandatory in production; minimum 32 random characters each)
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_at_least_32_characters_random_jwt_secret_value_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_different_32_characters_random_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Cache & Message Broker (Redis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# CORS Configuration (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Data Security & Encryption (Mandatory in production; minimum 32 random characters)
# Used for encrypting PII (PAN, Aadhaar) at rest via AES-256-GCM
PII_ENCRYPTION_KEY=generate_at_least_32_characters_random_pii_encryption_key_here

# Payment Gateway Webhook Verification
RAZORPAY_WEBHOOK_SECRET=generate_random_webhook_secret_key_from_razorpay_dashboard

# Metrics & Observability
# Token used by Prometheus scraper for Authorization: Bearer <token> or x-metrics-token header
METRICS_SCRAPE_TOKEN=generate_at_least_16_characters_prometheus_metrics_token_here

# API Documentation
ENABLE_SWAGGER=true

# ==============================================================================
# FRONTEND CONFIGURATION (apps/web)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
